#!/usr/bin/env python3
"""
⚡ UNIFIED FREEBUFF ACCOUNT SWITCHER (CLI & DESKTOP) ⚡
Dynamically auto-discovers accounts from Desktop, CLI instances, parent configs, and credentials.
Allows switching Desktop, CLI, or Both with single commands.
Supports ./switch test (health/bans) and ./switch streak (daily streak days & usage).
"""

import os
import sys
import json
import shutil
import urllib.request
import urllib.error
import subprocess
import hashlib
import concurrent.futures
from pathlib import Path

# Paths
SHARED_ACCOUNTS_FILE = os.path.expanduser("~/.config/freebuff-shared-accounts.json")
DELETED_ACCOUNTS_FILE = os.path.expanduser("~/.config/freebuff-deleted-accounts.json")
DESKTOP_STATE_PATH = os.path.expanduser("~/.config/freebuff-desktop/state.json")
CLI_CRED_PATH = os.path.expanduser("~/.config/manicode/credentials.json")

FREEBUFF_ALLACC_DIR = Path(os.path.expanduser("~/myworks/freebuffallacc"))
PARENT_CONFIG_PATH = FREEBUFF_ALLACC_DIR / ".freebuff-parent-1-config.json"
INSTANCES_DIR = FREEBUFF_ALLACC_DIR / "freebuff-cli-instances"
HOME_INSTANCES_DIR = Path(os.path.expanduser("~/.freebuff-cli-instances"))

BUFFDESKTOP_DIR = Path(os.path.expanduser("~/myworks/buffdesktop"))

FALLBACK_ACCOUNTS = []

def load_json(filepath):
    if not os.path.exists(filepath):
        return None
    try:
        with open(filepath, "r") as f:
            return json.load(f)
    except Exception:
        return None

def save_json(filepath, data):
    os.makedirs(os.path.dirname(filepath), exist_ok=True)
    with open(filepath, "w") as f:
        json.dump(data, f, indent=2)

def load_deleted_accounts():
    data = load_json(DELETED_ACCOUNTS_FILE)
    if isinstance(data, list):
        return set(a.lower() for a in data if isinstance(a, str))
    return set()

def save_deleted_account(item):
    if not item:
        return
    deleted = load_deleted_accounts()
    deleted.add(item.lower())
    save_json(DELETED_ACCOUNTS_FILE, list(deleted))

def remove_deleted_account(item):
    if not item:
        return
    deleted = load_deleted_accounts()
    deleted.discard(item.lower())
    save_json(DELETED_ACCOUNTS_FILE, list(deleted))

def check_token_status(token):
    if not token or len(token) < 10:
        return "⚪ UNSET"
    
    url = "https://www.codebuff.com/api/v1/chat/completions"
    headers = {
        "Authorization": f"Bearer {token}",
        "Content-Type": "application/json",
        "User-Agent": "Mozilla/5.0"
    }
    body = json.dumps({"model": "deepseek-v4-flash", "messages": [{"role": "user", "content": "hi"}], "max_tokens": 1}).encode()
    req = urllib.request.Request(url, data=body, headers=headers)
    
    try:
        with urllib.request.urlopen(req, timeout=4) as resp:
            return "🟢 WORKING"
    except urllib.error.HTTPError as e:
        if e.code in [401, 403]:
            return "🔴 BANNED / EXPIRED"
        elif e.code == 429:
            return "⚠️ RATE LIMITED"
        elif e.code == 400:
            return "🟢 WORKING"
        else:
            return f"⚠️ HTTP {e.code}"
    except Exception:
        return "⚠️ UNREACHABLE"

def fetch_streak_data(token):
    if not token or len(token) < 10:
        return {"streak": 0, "todayUsed": False, "lastUsageDate": "N/A", "status": "⚪ UNSET"}
    
    url = "https://www.codebuff.com/api/v1/freebuff/streak"
    req = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}", "User-Agent": "Mozilla/5.0"})
    
    try:
        with urllib.request.urlopen(req, timeout=5) as resp:
            d = json.loads(resp.read().decode())
            d["status"] = "🟢 OK"
            return d
    except urllib.error.HTTPError as e:
        return {"streak": 0, "todayUsed": False, "lastUsageDate": "N/A", "status": f"❌ HTTP {e.code}"}
    except Exception:
        return {"streak": 0, "todayUsed": False, "lastUsageDate": "N/A", "status": "❌ Error"}

def get_account_fingerprint(email, token):
    seed = f"freebuff_unique_account_{email}_{token}"
    fp_hash = hashlib.sha256(seed.encode()).hexdigest()
    fp_id = "enhanced-" + hashlib.sha256((seed + "_id").encode()).hexdigest()[:43]
    return fp_id, fp_hash

def discover_all_accounts():
    deleted = load_deleted_accounts()

    slot_accounts = {}
    for slot in range(1, 9):
        slot_accounts[slot] = {
            "name": f"freebuff-cli-slot-{slot}",
            "email": "not logged in",
            "token": "",
            "id": f"usr_slot_{slot}",
            "display_name": f"slot-{slot}",
            "slot": slot
        }

    for i, acc in enumerate(FALLBACK_ACCOUNTS, 1):
        if acc["email"].lower() in deleted or acc["token"].lower() in deleted:
            slot_accounts[i] = {
                "name": f"freebuff-cli-slot-{i}",
                "email": "not logged in",
                "token": "",
                "id": f"usr_slot_{i}",
                "display_name": f"slot-{i}",
                "slot": i
            }
        else:
            slot_accounts[i] = {
                "name": acc["name"],
                "email": acc["email"],
                "token": acc["token"],
                "id": acc["id"],
                "display_name": acc["display_name"],
                "slot": i
            }

    for slot in range(1, 9):
        for target_dir in [HOME_INSTANCES_DIR, INSTANCES_DIR]:
            cred = load_json(target_dir / f"instance{slot}" / "home/.config/manicode/credentials.json")
            if cred:
                for k, v in cred.items():
                    if isinstance(v, dict) and v.get("authToken") and v.get("email"):
                        email_lc = v["email"].lower()
                        tok_lc = v["authToken"].lower()
                        if email_lc not in deleted and tok_lc not in deleted:
                            slot_accounts[slot] = {
                                "name": v.get("name") or v["email"].split("@")[0],
                                "email": v["email"],
                                "token": v["authToken"],
                                "id": v.get("id") or f"usr_slot_{slot}",
                                "display_name": v.get("name") or v["email"].split("@")[0],
                                "slot": slot
                            }

    accounts_by_key = {}
    for slot in range(1, 9):
        acc = slot_accounts[slot]
        if acc["email"] != "not logged in":
            accounts_by_key[acc["email"].lower()] = acc

    def add_extra_acc(token, email, name=None, user_id=None):
        if not token or not isinstance(token, str) or len(token) < 10:
            return
        key = email.lower() if email else token
        if key in deleted or token.lower() in deleted:
            return
        if key not in accounts_by_key:
            accounts_by_key[key] = {
                "name": name or (email.split("@")[0] if email else "Account"),
                "email": email or "unknown@email.com",
                "token": token,
                "id": user_id or f"usr_{hash(token) % 1000000}",
                "display_name": name or (email.split("@")[0] if email else "Account")
            }

    shared = load_json(SHARED_ACCOUNTS_FILE)
    if isinstance(shared, list):
        for acc in shared:
            add_extra_acc(acc.get("token"), acc.get("email"), acc.get("name"), acc.get("id"))

    desktop_state = load_json(DESKTOP_STATE_PATH)
    if desktop_state and "authSessions" in desktop_state:
        for host, auth in desktop_state["authSessions"].items():
            if isinstance(auth, dict) and auth.get("token"):
                user = auth.get("user", {})
                add_extra_acc(auth.get("token"), user.get("email"), user.get("name"), user.get("id"))

    cli_cred = load_json(CLI_CRED_PATH)
    if cli_cred:
        for k, v in cli_cred.items():
            if isinstance(v, dict) and v.get("authToken"):
                add_extra_acc(v.get("authToken"), v.get("email"), v.get("name"), v.get("id"))

    acc_list = list(accounts_by_key.values())
    clean_shared = [a for a in acc_list if a["email"].lower() not in deleted and a["token"].lower() not in deleted]
    save_json(SHARED_ACCOUNTS_FILE, clean_shared)
    return clean_shared

def test_all_accounts():
    accs = discover_all_accounts()
    print("=" * 80)
    print(" 🔎 TESTING ALL FREEBUFF ACCOUNT SLOTS FOR HEALTH & BANS 🔎")
    print("=" * 80)
    print("Testing token validity against Freebuff API...\n")

    results = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as executor:
        future_to_acc = {executor.submit(check_token_status, acc["token"]): acc for acc in accs}
        for future in concurrent.futures.as_completed(future_to_acc):
            acc = future_to_acc[future]
            try:
                status = future.result()
            except Exception:
                status = "⚠️ ERROR"
            results.append((acc, status))

    results.sort(key=lambda x: accs.index(x[0]))

    print(f" {'#':<3} | {'Account Name':<16} | {'Email':<30} | Health Status")
    print("-" * 80)
    for i, (acc, status) in enumerate(results, 1):
        print(f" {i:<3} | {acc['name']:<16} | {acc['email']:<30} | {status}")
    print("-" * 80)
    print("Legend: 🟢 WORKING | 🔴 BANNED / EXPIRED | ⚠️ RATE LIMITED | ⚪ UNSET\n")

def check_streaks_all_accounts():
    accs = discover_all_accounts()
    print("=" * 95)
    print(" 🔥 FREEBUFF ACCOUNT STREAK DASHBOARD 🔥")
    print("=" * 95)
    print("Fetching streak data from Freebuff API...\n")

    results = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as executor:
        future_to_acc = {executor.submit(fetch_streak_data, acc["token"]): acc for acc in accs}
        for future in concurrent.futures.as_completed(future_to_acc):
            acc = future_to_acc[future]
            try:
                streak_info = future.result()
            except Exception:
                streak_info = {"streak": 0, "todayUsed": False, "lastUsageDate": "N/A", "status": "❌ Error"}
            results.append((acc, streak_info))

    results.sort(key=lambda x: accs.index(x[0]))

    print(f" {'#':<3} | {'Account Name':<16} | {'Email':<30} | {'Streak Days':<12} | {'Today Used':<10} | {'Last Usage Date'}")
    print("-" * 95)

    for i, (acc, s) in enumerate(results, 1):
        streak_count = s.get("streak", 0)
        today_used = "✅ Yes" if s.get("todayUsed") else "❌ No"
        last_date = s.get("lastUsageDate") or "N/A"
        streak_str = f"🔥 {streak_count} days"
        print(f" {i:<3} | {acc['name']:<16} | {acc['email']:<30} | {streak_str:<12} | {today_used:<10} | {last_date}")

    print("-" * 95)
    print("Tip: Use accounts daily to maintain your Freebuff active streak!\n")

def delete_account_slot(target_arg=None):
    accs = discover_all_accounts()
    if not accs:
        print("📭 No account slots available to delete.")
        return

    if not target_arg:
        dt_token = get_active_desktop_token()
        cli_token = get_active_cli_token()
        
        print("=" * 80)
        print(" 🗑️  DELETE ACCOUNT SLOT MENU")
        print("=" * 80)
        print(f" {'#':<3} | {'Account Name':<16} | {'Email':<30} | Status")
        print("-" * 80)
        for i, acc in enumerate(accs, 1):
            status_flags = []
            if acc["token"] == dt_token:
                status_flags.append("🖥️  DESKTOP")
            if acc["token"] == cli_token:
                status_flags.append("💻 CLI")
            status_str = " & ".join(status_flags) if status_flags else ""
            print(f" {i:<3} | {acc['name']:<16} | {acc['email']:<30} | {status_str}")
        print("-" * 80)
        
        try:
            choice = input("Select account slot number to DELETE (1-N) or 'q' to cancel: ").strip()
            if not choice or choice.lower() in ['q', 'cancel']:
                print("Deletion cancelled.")
                return
            target_arg = choice
        except (KeyboardInterrupt, EOFError):
            print("\nDeletion cancelled.")
            return

    target_acc = None
    if str(target_arg).isdigit():
        idx = int(target_arg) - 1
        if 0 <= idx < len(accs):
            target_acc = accs[idx]

    if not target_acc:
        for acc in accs:
            if acc["name"].lower() == str(target_arg).lower() or acc["email"].lower() == str(target_arg).lower():
                target_acc = acc
                break

    if not target_acc:
        print(f"❌ Account/Slot '{target_arg}' not found.")
        return

    email_to_remove = target_acc["email"].lower()
    token_to_remove = target_acc["token"]

    print(f"🗑️ Deleting Account/Slot: {target_acc['name']} ({target_acc['email']})...")

    save_deleted_account(email_to_remove)
    save_deleted_account(token_to_remove)

    shared = load_json(SHARED_ACCOUNTS_FILE)
    if isinstance(shared, list):
        shared = [a for a in shared if a.get("email", "").lower() != email_to_remove and a.get("token") != token_to_remove]
        save_json(SHARED_ACCOUNTS_FILE, shared)

    for target_dir in [HOME_INSTANCES_DIR, INSTANCES_DIR]:
        if str(target_arg).isdigit():
            slot_num = int(target_arg)
            inst_dir = target_dir / f"instance{slot_num}"
            if inst_dir.exists():
                shutil.rmtree(inst_dir, ignore_errors=True)

        for slot_dir in target_dir.glob("instance*"):
            cred_file = slot_dir / "home/.config/manicode/credentials.json"
            cred = load_json(cred_file)
            if cred:
                for v in cred.values():
                    if isinstance(v, dict) and (v.get("email", "").lower() == email_to_remove or v.get("authToken") == token_to_remove):
                        shutil.rmtree(slot_dir, ignore_errors=True)

    print(f"✅ Successfully deleted account slot '{target_arg}' ({target_acc['email']})!")

def get_active_desktop_token():
    state = load_json(DESKTOP_STATE_PATH)
    if state and "authSessions" in state:
        auth = state["authSessions"].get("https://www.codebuff.com", {})
        return auth.get("token")
    return None

def get_active_cli_token():
    cred = load_json(CLI_CRED_PATH)
    if cred:
        for v in cred.values():
            if isinstance(v, dict) and v.get("authToken"):
                return v.get("authToken")
    return None

def set_desktop_account(acc):
    state = load_json(DESKTOP_STATE_PATH) or {}
    if "authSessions" not in state:
        state["authSessions"] = {}
    state["authSessions"]["https://www.codebuff.com"] = {
        "token": acc["token"],
        "user": {
            "id": acc["id"],
            "email": acc["email"],
            "name": acc["display_name"]
        }
    }
    save_json(DESKTOP_STATE_PATH, state)
    print(f"✅ Desktop updated to: {acc['name']} ({acc['email']})")

    lock_base = os.path.expanduser("~/.config/freebuff-desktop/state.json.orchestrator-lock.sqlite")
    for ext in ["", "-wal", "-shm"]:
        p = lock_base + ext
        if os.path.exists(p):
            try:
                os.remove(p)
            except Exception:
                pass

    res = subprocess.run("pgrep -f '@codebufffreebuff-desktop' || pgrep -f 'runner.py'", shell=True, capture_output=True)
    if res.returncode == 0:
        print("🔄 Restarting Freebuff Desktop app...")
        stop_sh = BUFFDESKTOP_DIR / "stop.sh"
        start_sh = BUFFDESKTOP_DIR / "start.sh"
        if stop_sh.exists():
            subprocess.run(f"bash '{stop_sh}'", shell=True)
        if start_sh.exists():
            subprocess.run(f"bash '{start_sh}' >/dev/null 2>&1 &", shell=True)
            print("🚀 Desktop app restarted with new session!")

def set_cli_account(acc):
    fp_id, fp_hash = get_account_fingerprint(acc["email"], acc["token"])
    cli_cred = {
        "default": {
            "id": acc["id"],
            "name": acc["display_name"],
            "email": acc["email"],
            "authToken": acc["token"],
            "fingerprintId": fp_id,
            "fingerprintHash": fp_hash
        }
    }
    save_json(CLI_CRED_PATH, cli_cred)
    print(f"✅ CLI updated to: {acc['name']} ({acc['email']})")
    print(f"🔑 Assigned Unique Device Fingerprint: {fp_id[:20]}...")

def add_new_account(token, email, name=None):
    remove_deleted_account(email)
    remove_deleted_account(token)
    accs = discover_all_accounts()
    new_acc = {
        "name": name or (email.split("@")[0] if email else "NewAccount"),
        "email": email or "user@freebuff.com",
        "token": token.strip(),
        "id": f"usr_{hash(token) % 1000000}",
        "display_name": name or (email.split("@")[0] if email else "NewAccount")
    }
    accs.append(new_acc)
    save_json(SHARED_ACCOUNTS_FILE, accs)
    print(f"🎉 Successfully added new account: {new_acc['name']} ({new_acc['email']})!")
    return new_acc

def launch_cli_slot_login(slot, label=None):
    slot_label = label or f"freebuff-cli-slot-{slot}"
    target_dir = HOME_INSTANCES_DIR / f"instance{slot}"
    home_dir = target_dir / "home"
    os.makedirs(home_dir, exist_ok=True)

    env = os.environ.copy()
    env["HOME"] = str(home_dir)
    env["MANICODE_CONFIG_DIR"] = str(home_dir / ".config" / "manicode")

    sh_path = FREEBUFF_ALLACC_DIR / "freebuff-cli-instances.sh"
    if sh_path.exists():
        print(f"🔑 Launching Official Freebuff CLI Login for Slot {slot} [{slot_label}]...")
        subprocess.run(f"bash '{sh_path}' login {slot} '{slot_label}'", shell=True, cwd=FREEBUFF_ALLACC_DIR)
    else:
        print(f"🔑 Launching Freebuff Login for Slot {slot} [{slot_label}]...")
        subprocess.run("npx freebuff login", shell=True, env=env, cwd=str(home_dir))

    cred_file = home_dir / ".config" / "manicode" / "credentials.json"
    if not cred_file.exists():
        root_cred = Path(os.path.expanduser("~/.config/manicode/credentials.json"))
        if root_cred.exists():
            cred_file = root_cred

    cred = load_json(cred_file)
    if cred:
        for v in cred.values():
            if isinstance(v, dict) and v.get("authToken") and v.get("email"):
                tok = v["authToken"]
                email = v["email"]
                name = v.get("name") or email.split("@")[0]
                remove_deleted_account(email)
                remove_deleted_account(tok)

                inst_cred_file = home_dir / ".config" / "manicode" / "credentials.json"
                save_json(inst_cred_file, {
                    "default": {
                        "id": v.get("id") or f"usr_slot_{slot}",
                        "name": name,
                        "email": email,
                        "authToken": tok
                    }
                })

                add_new_account(tok, email, name)
                acc = {
                    "name": name,
                    "email": email,
                    "token": tok,
                    "id": v.get("id") or f"usr_slot_{slot}",
                    "display_name": name,
                    "slot": slot
                }
                set_desktop_account(acc)
                set_cli_account(acc)
                print(f"🎉 Slot {slot} successfully logged in & activated: {name} ({email})!")

