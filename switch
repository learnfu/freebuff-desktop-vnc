def main():
    accounts = discover_all_accounts()
    dt_token = get_active_desktop_token()
    cli_token = get_active_cli_token()

    args = sys.argv[1:]
    if args:
        first = args[0].lower()

        if first in ["--help", "-h", "help"]:
            print_help()
            return

        if first in ["list", "ls"]:
            print_unified_menu(accounts, dt_token, cli_token)
            return

        if first in ["auto-streak", "autostreak", "boost"]:
            auto_streak_path = BUFFDESKTOP_DIR / "auto_streak.py"
            if auto_streak_path.exists():
                subprocess.run([sys.executable, str(auto_streak_path)])
            else:
                print("auto_streak.py not found.")
            return

        if first in ["streak", "streaks", "fire"]:
            check_streaks_all_accounts()
            return

        if first in ["test", "check", "verify", "health"]:
            test_all_accounts()
            return

        if first in ["delete", "rm", "remove"]:
            target = args[1] if len(args) >= 2 else None
            delete_account_slot(target)
            return

        if first in ["add", "login"]:
            if len(args) >= 3 and len(args[1]) > 10:
                token = args[1]
                email = args[2]
                name = args[3] if len(args) >= 4 else None
                add_new_account(token, email, name)
                return
            elif len(args) >= 2 and args[1].isdigit():
                slot = int(args[1])
                label = args[2] if len(args) >= 3 else None
                launch_cli_slot_login(slot, label)
                return
            else:
                next_slot = len(accounts) + 1
                launch_cli_slot_login(next_slot)
                return

        selected = None
        app_choice = "both"

        if first.isdigit():
            idx = int(first) - 1
            if 0 <= idx < len(accounts):
                selected = accounts[idx]
        else:
            for acc in accounts:
                if acc["name"].lower() == first or acc["email"].lower() == first:
                    selected = acc
                    break

        if len(args) >= 2:
            app_choice = args[1].lower()

        if selected:
            if app_choice in ["desktop", "d"]:
                set_desktop_account(selected)
            elif app_choice in ["cli", "c"]:
                set_cli_account(selected)
            else:
                set_desktop_account(selected)
                set_cli_account(selected)
            return

    print_unified_menu(accounts, dt_token, cli_token)
    try:
        choice = input("Select account number (1-N) or command: ").strip()
        if not choice or choice.lower() == 'q':
            print("Exiting.")
            return

        if choice.lower() in ["--help", "-h", "help"]:
            print_help()
            return

        if choice.lower() in ["list", "ls"]:
            print_unified_menu(accounts, dt_token, cli_token)
            return

        if choice.lower() in ["auto-streak", "autostreak", "boost"]:
            auto_streak_path = BUFFDESKTOP_DIR / "auto_streak.py"
            if auto_streak_path.exists():
                subprocess.run([sys.executable, str(auto_streak_path)])
            else:
                print("auto_streak.py not found.")
            return

        if choice.lower() in ["streak", "streaks", "fire"]:
            check_streaks_all_accounts()
            return

        if choice.lower() in ["test", "check", "verify", "health"]:
            test_all_accounts()
            return

        parts = choice.split()
        if parts[0].lower() in ["delete", "rm", "remove"]:
            target = parts[1] if len(parts) >= 2 else None
            delete_account_slot(target)
            return

        if parts[0].lower() in ["add", "login"]:
            if len(parts) >= 3 and len(parts[1]) > 10:
                add_new_account(parts[1], parts[2], parts[3] if len(parts) >= 4 else None)
                return
            elif len(parts) >= 2 and parts[1].isdigit():
                launch_cli_slot_login(int(parts[1]))
                return
            else:
                next_slot = len(accounts) + 1
                launch_cli_slot_login(next_slot)
                return

        selected = None
        if parts[0].isdigit():
            idx = int(parts[0]) - 1
            if 0 <= idx < len(accounts):
                selected = accounts[idx]

        if not selected:
            print("Invalid account choice.")
            return

        print("\nSelect target application:")
        print("  [1] BOTH Desktop & CLI (Recommended)")
        print("  [2] Desktop GUI only")
        print("  [3] CLI / Terminal only")
        app_sel = input("Choice (1-3, default 1): ").strip()

        if app_sel == "2":
            set_desktop_account(selected)
        elif app_sel == "3":
            set_cli_account(selected)
        else:
            set_desktop_account(selected)
            set_cli_account(selected)

    except (KeyboardInterrupt, EOFError):
        print("\nExiting.")

if __name__ == "__main__":
    main()
