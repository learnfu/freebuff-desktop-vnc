def get_account_fingerprint(email, token):
    """Generates a unique, deterministic device fingerprint per account."""
    seed = f"freebuff_unique_account_{email}_{token}"
    fp_hash = hashlib.sha256(seed.encode()).hexdigest()
    fp_id = "enhanced-" + hashlib.sha256((seed + "_id").encode()).hexdigest()[:43]
    return fp_id, fp_hash

def load_json(filepath):
    if not os.path.exists(filepath):
        return None
    try:
        with open(filepath, "r") as f:
            return json.load(f)
    except Exception:
        return None

def save_json(filepath, data):
    os.makedirs(os.path.dirname(filepath), exist_ok=True)
    with open(filepath, "w") as f:
        json.dump(data, f, indent=2)

def discover_all_accounts():
    # Slots 1..8 map directly to fallback/CLI instance slots
    slot_accounts = {}
    for i, acc in enumerate(FALLBACK_ACCOUNTS, 1):
        slot_accounts[i] = {
            "name": acc["name"],
            "email": acc["email"],
            "token": acc["token"],
            "id": acc["id"],
            "display_name": acc["display_name"],
            "slot": i
        }

    # Check CLI instance slots 1..8 to OVERWRITE slot accounts if logged in
    for slot in range(1, 9):
        for target_dir in [HOME_INSTANCES_DIR, INSTANCES_DIR]:
            cred = load_json(target_dir / f"instance{slot}" / "home/.config/manicode/credentials.json")
            if cred:
                for k, v in cred.items():
                    if isinstance(v, dict) and v.get("authToken") and v.get("email"):
                        slot_accounts[slot] = {
                            "name": v.get("name") or v["email"].split("@")[0],
                            "email": v["email"],
                            "token": v["authToken"],
                            "id": v.get("id") or f"usr_slot_{slot}",
                            "display_name": v.get("name") or v["email"].split("@")[0],
                            "slot": slot
                        }

    accounts_by_key = {}
    # First add mapped slot accounts 1..8
    for slot in range(1, 9):
        acc = slot_accounts[slot]
        accounts_by_key[acc["email"].lower()] = acc

    def add_extra_acc(token, email, name=None, user_id=None):
        if not token or not isinstance(token, str) or len(token) < 10:
            return
        key = email.lower() if email else token
        if key not in accounts_by_key:
            accounts_by_key[key] = {
                "name": name or (email.split("@")[0] if email else "Account"),
                "email": email or "unknown@email.com",
                "token": token,
                "id": user_id or f"usr_{hash(token) % 1000000}",
                "display_name": name or (email.split("@")[0] if email else "Account")
            }

    shared = load_json(SHARED_ACCOUNTS_FILE)
    if isinstance(shared, list):
        for acc in shared:
            add_extra_acc(acc.get("token"), acc.get("email"), acc.get("name"), acc.get("id"))

    desktop_state = load_json(DESKTOP_STATE_PATH)
    if desktop_state and "authSessions" in desktop_state:
        for host, auth in desktop_state["authSessions"].items():
            if isinstance(auth, dict) and auth.get("token"):
                user = auth.get("user", {})
                add_extra_acc(auth.get("token"), user.get("email"), user.get("name"), user.get("id"))

    cli_cred = load_json(CLI_CRED_PATH)
    if cli_cred:
        for k, v in cli_cred.items():
            if isinstance(v, dict) and v.get("authToken"):
                add_extra_acc(v.get("authToken"), v.get("email"), v.get("name"), v.get("id"))

    acc_list = list(accounts_by_key.values())
    save_json(SHARED_ACCOUNTS_FILE, acc_list)
    return acc_list

def get_active_desktop_token():
    state = load_json(DESKTOP_STATE_PATH)
    if state and "authSessions" in state:
        auth = state["authSessions"].get("https://www.codebuff.com", {})
        return auth.get("token")
    return None

def get_active_cli_token():
    cred = load_json(CLI_CRED_PATH)
    if cred:
        for v in cred.values():
            if isinstance(v, dict) and v.get("authToken"):
                return v.get("authToken")
    return None

def set_desktop_account(acc):
    state = load_json(DESKTOP_STATE_PATH) or {}
    if "authSessions" not in state:
        state["authSessions"] = {}
    state["authSessions"]["https://www.codebuff.com"] = {
        "token": acc["token"],
        "user": {
            "id": acc["id"],
            "email": acc["email"],
            "name": acc["display_name"]
        }
    }
    save_json(DESKTOP_STATE_PATH, state)
    print(f"✅ Desktop updated to: {acc['name']} ({acc['email']})")

    # Clean up stale orchestrator locks
    lock_base = os.path.expanduser("~/.config/freebuff-desktop/state.json.orchestrator-lock.sqlite")
    for ext in ["", "-wal", "-shm"]:
        p = lock_base + ext
        if os.path.exists(p):
            try:
                os.remove(p)
            except Exception:
                pass

    res = subprocess.run("pgrep -f '@codebufffreebuff-desktop' || pgrep -f 'runner.py'", shell=True, capture_output=True)
    if res.returncode == 0:
        print("🔄 Restarting Freebuff Desktop app...")
        stop_sh = BUFFDESKTOP_DIR / "stop.sh"
        start_sh = BUFFDESKTOP_DIR / "start.sh"
        if stop_sh.exists():
            subprocess.run(f"bash '{stop_sh}'", shell=True)
        if start_sh.exists():
            subprocess.run(f"bash '{start_sh}' >/dev/null 2>&1 &", shell=True)
            print("🚀 Desktop app restarted with new session!")

def set_cli_account(acc):
    fp_id, fp_hash = get_account_fingerprint(acc["email"], acc["token"])
    cli_cred = {
        "default": {
            "id": acc["id"],
            "name": acc["display_name"],
            "email": acc["email"],
            "authToken": acc["token"],
            "fingerprintId": fp_id,
            "fingerprintHash": fp_hash
        }
    }
    save_json(CLI_CRED_PATH, cli_cred)
    print(f"✅ CLI updated to: {acc['name']} ({acc['email']})")
    print(f"🔑 Assigned Unique Device Fingerprint: {fp_id[:20]}...")

def add_new_account(token, email, name=None):
    accs = discover_all_accounts()
    new_acc = {
        "name": name or (email.split("@")[0] if email else "NewAccount"),
        "email": email or "user@freebuff.com",
        "token": token.strip(),
        "id": f"usr_{hash(token) % 1000000}",
        "display_name": name or (email.split("@")[0] if email else "NewAccount")
    }
    accs.append(new_acc)
    save_json(SHARED_ACCOUNTS_FILE, accs)
    print(f"🎉 Successfully added new account: {new_acc['name']} ({new_acc['email']})!")
    return new_acc

def launch_cli_slot_login(slot, label=None):
    slot_label = label or f"freebuff-cli-slot-{slot}"
    sh_path = FREEBUFF_ALLACC_DIR / "freebuff-cli-instances.sh"
    if sh_path.exists():
        print(f"🔑 Launching Official Freebuff CLI Login for Slot {slot} [{slot_label}]...")
        subprocess.run(f"bash '{sh_path}' login {slot} '{slot_label}'", shell=True, cwd=FREEBUFF_ALLACC_DIR)
    else:
        print(f"🔑 Launching Freebuff Login for Slot {slot}...")
        subprocess.run(f"npx freebuff login", shell=True)

    # Post-login: Refresh discovered accounts & activate slot directly
    accs = discover_all_accounts()
    if 0 < slot <= len(accs):
        target_acc = accs[slot - 1]
        set_cli_account(target_acc)
        print(f"🎉 Slot {slot} successfully updated & activated: {target_acc['name']} ({target_acc['email']})!")

def print_unified_menu(accounts, dt_token, cli_token):
    print("=" * 80)
    print(" ⚡ UNIFIED FREEBUFF ACCOUNT SWITCHER (CLI & DESKTOP) ⚡")
    print("=" * 80)
    print(f" {'#':<3} | {'Account Name':<16} | {'Email':<30} | Active Status")
    print("-" * 80)

    for i, acc in enumerate(accounts, 1):
        status_flags = []
        if acc["token"] == dt_token:
            status_flags.append("🖥️  DESKTOP ACTIVE")
        if acc["token"] == cli_token:
            status_flags.append("💻 CLI ACTIVE")
        
        status_str = " & ".join(status_flags) if status_flags else ""
        pointer = "👉 " if status_flags else "   "
        
        print(f"{pointer}{i:<2} | {acc['name']:<16} | {acc['email']:<30} | {status_str}")

    print("-" * 80)
    print("Commands:")
    print("  • Enter account number (e.g. '1') to choose target app to activate")
    print("  • './switch login <slot>' to launch interactive CLI login for a slot")
    print("  • './switch add <token> <email> [name]' to register a brand new account token")
    print("  • 'q' to exit\n")

def main():
    accounts = discover_all_accounts()
    dt_token = get_active_desktop_token()
    cli_token = get_active_cli_token()

    args = sys.argv[1:]
    if args:
        first = args[0].lower()

        if first in ["add", "login"]:
            if len(args) >= 3 and len(args[1]) > 10:
                token = args[1]
                email = args[2]
                name = args[3] if len(args) >= 4 else None
                add_new_account(token, email, name)
                return
            elif len(args) >= 2 and args[1].isdigit():
                slot = int(args[1])
                label = args[2] if len(args) >= 3 else None
                launch_cli_slot_login(slot, label)
                return
            elif len(args) == 1:
                launch_cli_slot_login(1)
                return

        selected = None
        app_choice = "both"

        if first.isdigit():
            idx = int(first) - 1
            if 0 <= idx < len(accounts):
                selected = accounts[idx]
        else:
            for acc in accounts:
                if acc["name"].lower() == first or acc["email"].lower() == first:
                    selected = acc
                    break

        if len(args) >= 2:
            app_choice = args[1].lower()

        if selected:
            if app_choice in ["desktop", "d"]:
                set_desktop_account(selected)
            elif app_choice in ["cli", "c"]:
                set_cli_account(selected)
            else:
                set_desktop_account(selected)
                set_cli_account(selected)
            return

    print_unified_menu(accounts, dt_token, cli_token)
    try:
        choice = input("Select account number (1-N) or command: ").strip()
        if not choice or choice.lower() == 'q':
            print("Exiting.")
            return

        parts = choice.split()
        if parts[0].lower() in ["add", "login"] and len(parts) >= 2 and parts[1].isdigit():
            launch_cli_slot_login(int(parts[1]))
            return

        if parts[0].lower() in ["add", "login"] and len(parts) >= 3:
            add_new_account(parts[1], parts[2], parts[3] if len(parts) >= 4 else None)
            return

        selected = None
        if parts[0].isdigit():
            idx = int(parts[0]) - 1
            if 0 <= idx < len(accounts):
                selected = accounts[idx]

        if not selected:
            print("Invalid account choice.")
            return

        print("\nSelect target application:")
        print("  [1] BOTH Desktop & CLI (Recommended)")
        print("  [2] Desktop GUI only")
        print("  [3] CLI / Terminal only")
        app_sel = input("Choice (1-3, default 1): ").strip()

        if app_sel == "2":
            set_desktop_account(selected)
        elif app_sel == "3":
            set_cli_account(selected)
        else:
            set_desktop_account(selected)
            set_cli_account(selected)

    except (KeyboardInterrupt, EOFError):
        print("\nExiting.")

if __name__ == "__main__":
    main()
